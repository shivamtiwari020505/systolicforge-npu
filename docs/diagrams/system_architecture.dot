digraph SystolicForgeSystem {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.42",
    ranksep="0.72",
    splines=polyline,
    size="11,8!",
    ratio="compress",
    fontname="Arial",
    label="SystolicForge NPU — implemented system architecture",
    labelloc=t,
    fontsize=22
  ];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11,
        color="#334155", fillcolor="#f8fafc", fontcolor="#0f172a", margin="0.13,0.09"];
  edge [fontname="Arial", fontsize=9, color="#475569", fontcolor="#334155", arrowsize=0.75];

  subgraph cluster_software {
    label="Software / build time";
    color="#93c5fd";
    style="rounded,dashed";
    compiler [label="systolicforge_compile.py\nJSON / optional ONNX frontend\nquantize • tile • encode", fillcolor="#eff6ff", color="#2563eb"];
    artifacts [label="Generated images\nprogram.hex (128-bit words)\na.hex • b.hex • expected C", shape=note, fillcolor="#eff6ff", color="#2563eb"];
    compiler -> artifacts [label="emits"];
  }

  subgraph cluster_soc {
    label="systolicforge_soc";
    color="#64748b";
    style="rounded";

    dma [label="scratchpad_dma\n32-bit, word-burst engine\nrange preflight • 1 read outstanding", fillcolor="#fff7ed", color="#ea580c"];

    subgraph cluster_npu {
      label="systolicforge_npu";
      color="#0f766e";
      style="rounded";

      imem [label="Synchronous instruction RAM\n256 × 128-bit default", fillcolor="#ecfeff", color="#0891b2"];
      fsm [label="Sequencer + PC + bounds preflight\nFETCH → DECODE → PREFETCH\n→ LOAD / ISSUE → WRITEBACK", fillcolor="#f0fdfa", color="#0f766e"];
      regs [label="Decoded tile registers\nM, K, N • bases • strides\nACCUMULATE", fillcolor="#f0fdfa", color="#0f766e"];

      sp_a [label="Synchronous A RAM\n4096 × INT8", fillcolor="#fefce8", color="#ca8a04"];
      sp_b [label="Synchronous B RAM\n4096 × INT8", fillcolor="#fefce8", color="#ca8a04"];
      sp_c [label="Synchronous C RAM\n4096 × INT32", fillcolor="#fefce8", color="#ca8a04"];
      tile [label="Prefetched registers\none A row + B tile", fillcolor="#f0fdfa", color="#0f766e"];
      wb [label="C writeback pipeline\nregistered read + wrap/add", fillcolor="#f0fdfa", color="#0f766e"];

      array [label="systolic_array\nR × C signed INT8 MAC PEs\nweight-stationary dataflow", fillcolor="#f5f3ff", color="#7c3aed", penwidth=1.6];

      imem -> fsm [label="instruction[127:0]"];
      fsm -> regs [label="decode / latch"];
      regs -> sp_a [style=dashed, arrowhead=none, label="base + row·lda + k"];
      regs -> sp_b [style=dashed, arrowhead=none, label="base + k·ldb + col"];
      regs -> sp_c [style=dashed, arrowhead=none, label="base + row·ldc + col"];
      fsm -> array [label="weight_load\ninput_valid"];
      sp_a -> tile [label="one INT8 word / read"];
      sp_b -> tile [label="one INT8 word / read"];
      tile -> array [label="buffered activations / weights"];
      array -> wb [label="one active column / cycle"];
      sp_c -> wb [label="old C (accumulate)"];
      wb -> sp_c [label="one INT32 write / cycle"];
    }
  }

  host [label="CPU / host software\nprogram image • DMA setup\ninterrupt handler", fillcolor="#f1f5f9"];
  axi [label="systolicforge_axi_lite\n32-bit register bank\nWSTRB • SLVERR/DECERR • sticky IRQ", fillcolor="#ecfdf5", color="#059669"];
  extmem [label="External memory\n32-bit request/response", shape=cylinder, fillcolor="#fff7ed", color="#ea580c"];

  artifacts -> host [label="load"];
  host -> axi [dir=both, label="AXI4-Lite\n+ irq", color="#059669"];
  axi -> imem [label="program_we / addr / data"];
  axi -> fsm [label="start", color="#0f766e"];
  fsm -> axi [label="busy / done / fault_code", color="#0f766e"];
  axi -> dma [label="DMA command"];
  dma -> axi [label="ready / busy / done / fault_code"];
  extmem -> dma [dir=both, label="valid / ready\nread response"];
  dma -> sp_a [dir=both, label="local port when !busy"];
  dma -> sp_b [dir=both];
  dma -> sp_c [dir=both];
}
